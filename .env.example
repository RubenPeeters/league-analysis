# Copy to .env and fill in. Never commit .env.
RIOT_API_KEY=RGAPI-xxxxxxxx
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/

# Web service (src/web.py). Discord application: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret
DISCORD_GUILD_ID=your-server-id
DISCORD_ROLE_ID=your-role-id
# long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SESSION_SECRET=change-me
# the address Caddy serves the service on; Discord's redirect URL is PUBLIC_URL/auth/discord/callback
PUBLIC_URL=https://scout.example.com
